{
  "name": "portrai-firestore",
  "private": true,
  "description": "Firestore security rules for PortRai and their emulator tests",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "volta": {
    "node": "22.23.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "firebase emulators:exec --only firestore --project demo-portrai \"vitest run\"",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "22.20.5",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
