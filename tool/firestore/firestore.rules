rules_version = '2';

// Clients get only what the app needs. Server code (Cloud Functions, the
// export/import tool) uses service accounts, which these rules do not apply to.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The user may set `enabled`; `updatedAt` must be the server time.
    function isValidJobSearch(jobSearch) {
      return jobSearch is map
        && jobSearch.keys().hasOnly(['enabled', 'updatedAt'])
        && jobSearch.enabled is bool
        && jobSearch.updatedAt == request.time;
    }

    // A device of the user that receives their notifications, keyed by its
    // token. `updatedAt` must be the server time.
    function isValidDevice(device) {
      return device.keys().hasOnly(['locale', 'platform', 'updatedAt'])
        && device.keys().hasAll(['locale', 'platform', 'updatedAt'])
        && device.locale is string
        && device.locale.size() <= 10
        && device.platform in ['android', 'ios', 'web']
        && device.updatedAt == request.time;
    }

    // Portfolio content, one document per locale. Public, read-only.
    match /profile/{locale} {
      allow get: if true;
    }
    match /experiences/{locale} {
      allow get: if true;
    }
    match /expertise/{locale} {
      allow get: if true;
    }
    match /projects/{locale} {
      allow get: if true;
    }
    match /services/{locale} {
      allow get: if true;
    }
    match /testimonials/{locale} {
      allow get: if true;
    }
    match /app_config/{configId} {
      allow get: if true;
    }
    // When each portfolio collection last changed, written by functions only.
    match /portfolio_versions/{locale} {
      allow get: if true;
    }

    // Private to each signed-in user. The user may change only `jobSearch`.
    match /users/{userId} {
      allow get: if isSignedInAs(userId);
      allow create: if isSignedInAs(userId)
        && request.resource.data.keys().hasOnly(['jobSearch'])
        && isValidJobSearch(request.resource.data.jobSearch);
      allow update: if isSignedInAs(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['jobSearch'])
        && isValidJobSearch(request.resource.data.jobSearch);

      // Written by the job openings function only.
      match /job_openings/{jobOpeningId} {
        allow read: if isSignedInAs(userId);
      }

      // Registered while the user is signed in on a device. Signing out
      // replaces the device token; the functions delete a registration whose
      // token is no longer registered. Only functions read the list.
      match /devices/{token} {
        allow get, delete: if isSignedInAs(userId);
        allow create, update: if isSignedInAs(userId)
          && token.size() <= 4096
          && isValidDevice(request.resource.data);
      }
    }
  }
}
