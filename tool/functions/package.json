{
  "name": "portrai-functions",
  "private": true,
  "description": "Cloud Functions for PortRai: a weekly job openings sync.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "volta": {
    "node": "22.23.3"
  }
}
